# Copy to .env for local configuration. Never commit real credentials.
# Local dev frontend is port 5173; production serves dist on PORT (default 3001).
# Set APP_URL explicitly to your public HTTPS origin in production.
APP_URL=http://localhost:5173
PORT=3001
DATABASE_PATH=.data/scopebook.sqlite

# Checkout remains unavailable until BOTH credentials are configured.
# Use Stripe test-mode keys before taking real payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: an active, one-time, USD 29.00 Stripe price.
# Without this, checkout creates a fixed USD 29.00 inline price.
STRIPE_PRICE_ID=
